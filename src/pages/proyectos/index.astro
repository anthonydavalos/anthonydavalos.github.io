---
import ProjectCard from "../../components/ProjectCard.astro";
import ProjectFilters from "../../components/ProjectFilters.astro";
import { projectFilters, projects } from "../../data/projects";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Proyectos | Anthony Davalos"
  description="Proyectos de software, APIs y automatización de Anthony Davalos."
>
  <section class="section soft-background" aria-labelledby="projects-title">
    <div class="container">
      <div class="section-heading" data-aos="fade-up">
        <p class="eyebrow section-heading__rule">Portafolio</p>
        <h1 id="projects-title">Proyectos</h1>
        <p>
          Proyectos destacados, archivados y en revisión, con su estado visible
          para dar contexto a cada uno.
        </p>
      </div>

      <ProjectFilters filters={projectFilters} />

      <div class="project-grid" data-project-grid>
        {
          projects.map((project) => (
            <div class:list={["project-grid__item", ...project.filters]}>
              <ProjectCard project={project} />
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1.5rem;
  }

  .project-grid[data-enhanced="true"] {
    display: block;
    margin: -0.75rem;
  }

  .project-grid[data-enhanced="true"] .project-grid__item {
    width: 100%;
    padding: 0.75rem;
  }

  @media (min-width: 48rem) {
    .project-grid[data-enhanced="true"] .project-grid__item {
      width: 50%;
    }
  }

  @media (min-width: 75rem) {
    .project-grid[data-enhanced="true"] .project-grid__item {
      width: 33.333%;
    }
  }
</style>
