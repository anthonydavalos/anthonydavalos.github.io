---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Página no encontrada | Anthony Davalos"
  description="La ruta solicitada no existe en este portafolio."
  noindex
>
  <section class="section soft-background" aria-labelledby="not-found-title">
    <div class="container not-found">
      <p class="eyebrow">Error 404</p>
      <h1 id="not-found-title">Esta página no está disponible</h1>
      <p>
        La dirección puede haber cambiado o no existir. Puedes volver al inicio
        o consultar los proyectos publicados.
      </p>
      <div class="not-found__actions">
        <a class="button" href="/">Volver al inicio</a>
        <a class="button" href="/proyectos/">Ver proyectos</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    max-width: 48rem;
    text-align: center;
  }

  .not-found h1 {
    margin-bottom: 1rem;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
  }

  .not-found > p:not(.eyebrow) {
    max-width: 36rem;
    margin: 0 auto;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
</style>
