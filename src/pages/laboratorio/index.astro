---
import PageIntro from "../../components/PageIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Laboratorio | Anthony Davalos"
  description="Laboratorio en progreso para automatización, observabilidad y ciberseguridad defensiva."
>
  <section class="section soft-background" aria-labelledby="lab-title">
    <div class="container">
      <PageIntro
        eyebrow="Laboratorio"
        title="Práctica responsable en progreso"
        titleId="lab-title"
        description="Este espacio reunirá notas técnicas y ejercicios publicados cuando cuenten con el contexto y la revisión necesarios."
      />

      <div class="row justify-content-center">
        <div class="col-lg-8" data-aos="fade-up">
          <article class="focus-card">
            <span class="focus-card__number" aria-hidden="true">Lab</span>
            <h2>Próximamente</h2>
            <p>
              Los laboratorios se publicarán de forma gradual, sin datos
              operativos, credenciales, configuraciones sensibles ni
              instrucciones que puedan causar daño.
            </p>
          </article>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
