---
import { Font } from "astro:assets";

import "../styles/global.css";

const focusAreas = [
  {
    title: "Software y APIs",
    description:
      "Diseño y desarrollo de sistemas e integraciones con atención a la mantenibilidad.",
  },
  {
    title: "Automatización",
    description:
      "Flujos que reducen tareas repetitivas y hacen visibles sus resultados.",
  },
  {
    title: "Ciberseguridad defensiva",
    description:
      "Laboratorio en progreso, documentación técnica y aprendizaje continuo.",
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Portafolio profesional de Anthony Davalos: ingeniería de software, automatización y ciberseguridad defensiva."
    />
    <meta name="theme-color" content="#ffffff" />
    <Font
      cssVariable="--font-roboto"
      preload={[{ weight: 400, style: "normal", subset: "latin" }]}
    />
    <Font
      cssVariable="--font-poppins"
      preload={[{ weight: 700, style: "normal", subset: "latin" }]}
    />
    <Font cssVariable="--font-raleway" />
    <title>Anthony Davalos | Portafolio profesional</title>
  </head>
  <body>
    <main>
      <section class="hero section" aria-labelledby="hero-title">
        <div class="container">
          <div class="row align-items-center gy-5 gx-lg-5">
            <div class="col-lg-7">
              <p class="eyebrow">Portafolio profesional</p>
              <h1 id="hero-title" class="hero__title">
                Anthony <span>Davalos</span>
              </h1>
              <p class="hero__lead">
                Construyo sistemas, integraciones y automatizaciones con foco en
                confiabilidad, observabilidad y aprendizaje continuo en
                seguridad defensiva.
              </p>
              <a class="button" href="#enfoque">Conocer mi enfoque</a>
            </div>

            <div class="col-lg-5">
              <div class="hero-visual">
                <p class="hero-visual__label">Ingeniería aplicada</p>
                <ul class="hero-visual__list">
                  {
                    focusAreas.map((area, index) => (
                      <li class="hero-visual__item">
                        <span class="hero-visual__number">
                          {String(index + 1).padStart(2, "0")}
                        </span>
                        <span>{area.title}</span>
                      </li>
                    ))
                  }
                </ul>
                <p class="hero-visual__footer">
                  Confiabilidad · Observabilidad · Mejora continua
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section
        id="enfoque"
        class="section light-background"
        aria-labelledby="focus-title"
      >
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow section-heading__rule">Áreas de trabajo</p>
            <h2 id="focus-title">
              Ingeniería de software, automatización y seguridad
            </h2>
            <p>
              Una base técnica enfocada en construir soluciones claras,
              verificables y sostenibles.
            </p>
          </div>

          <div class="row g-4">
            {
              focusAreas.map((area, index) => (
                <div class="col-md-6 col-lg-4">
                  <article class="focus-card">
                    <span class="focus-card__number" aria-hidden="true">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <h3>{area.title}</h3>
                    <p>{area.description}</p>
                  </article>
                </div>
              ))
            }
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
