---
import PageIntro from "../../components/PageIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Ciberseguridad defensiva | Anthony Davalos"
  description="Enfoque profesional de Anthony Davalos en ciberseguridad defensiva y aprendizaje continuo."
>
  <section class="section" aria-labelledby="security-title">
    <div class="container">
      <PageIntro
        eyebrow="Ciberseguridad"
        title="Seguridad defensiva con aprendizaje continuo"
        titleId="security-title"
        description="Un enfoque construido sobre experiencia práctica en soporte, redes y diagnóstico, actualmente ampliado mediante laboratorio, observabilidad y aprendizaje continuo."
      />

      <article
        class="security-origin"
        aria-labelledby="security-origin-title"
        data-aos="fade-up"
      >
        <div>
          <p class="eyebrow">Antecedente técnico · 2007-2009</p>
          <h2 id="security-origin-title">
            Redes, diagnóstico remoto y reputación de IP
          </h2>
        </div>
        <div>
          <p>
            En el Helpdesk de Telefónica Movistar, operado por Atento Perú,
            realicé soporte remoto, diagnóstico de redes, configuración de
            routers, NAT y VPN, y revisión de pools y bloqueos de IP. Esta
            experiencia aportó una base temprana en trazabilidad y seguridad
            defensiva.
          </p>
        </div>
      </article>

      <div class="row g-4">
        <div class="col-md-6 col-lg-4" data-aos="fade-up">
          <article class="focus-card">
            <span class="focus-card__number" aria-hidden="true">01</span>
            <h2>Fundamentos defensivos</h2>
            <p>
              Estudio de superficies de ataque, control de acceso y prácticas de
              endurecimiento aplicadas en entornos de laboratorio.
            </p>
          </article>
        </div>
        <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="70">
          <article class="focus-card">
            <span class="focus-card__number" aria-hidden="true">02</span>
            <h2>Observabilidad</h2>
            <p>
              Interés en registros, señales y trazabilidad para entender el
              comportamiento de sistemas y automatizaciones.
            </p>
          </article>
        </div>
        <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="140">
          <article class="focus-card">
            <span class="focus-card__number" aria-hidden="true">03</span>
            <h2>Laboratorio en progreso</h2>
            <p>
              Práctica controlada, documentación y mejora gradual de habilidades
              en ciberseguridad defensiva.
            </p>
          </article>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .security-origin {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    padding: clamp(1.4rem, 4vw, 2.4rem);
    border: 1px solid var(--border-color);
    border-left: 0.25rem solid var(--accent-color);
    border-radius: var(--radius-lg);
    background: var(--light-background-color);
  }

  .security-origin h2 {
    margin-bottom: 0;
    font-size: clamp(1.65rem, 4vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .security-origin p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 47.998rem) {
    .security-origin {
      grid-template-columns: 1fr;
    }
  }
</style>
