---
interface Props {
  value: number;
  displayValue: string;
  suffix?: string;
  label: string;
}

const { value, displayValue, suffix = "", label } = Astro.props;
---

<article class="metric-counter">
  <p class="metric-counter__value" aria-label={`${displayValue}${suffix}`}>
    <span
      aria-hidden="true"
      data-purecounter-start="0"
      data-purecounter-end={String(value)}
      data-purecounter-duration="1"
      data-purecounter-separator="true"
      data-purecounter-once="true"
    >
      {displayValue}
    </span>
    <span aria-hidden="true">{suffix}</span>
  </p>
  <p class="metric-counter__label">{label}</p>
</article>

<style>
  .metric-counter {
    height: 100%;
    padding: 1.35rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--surface-color);
    text-align: center;
    box-shadow: var(--shadow-card);
  }

  .metric-counter__value {
    margin-bottom: 0.35rem;
    color: var(--accent-color);
    font-family: var(--heading-font);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .metric-counter__label {
    margin: 0;
    color: var(--subtitle-color);
    font-family: var(--heading-font);
    font-size: 0.82rem;
    font-weight: 600;
  }
</style>
