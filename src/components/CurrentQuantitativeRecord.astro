---
import type { QuantitativeRecord } from "../data/achievements";

import EvidenceSources from "./EvidenceSources.astro";
import SourceStatusBadge from "./SourceStatusBadge.astro";

interface Props {
  record: QuantitativeRecord;
}

const { record } = Astro.props;
---

<article id={record.id} class="current-record" data-aos="fade-up">
  <header class="current-record__header">
    <div>
      <p class="eyebrow">Seguimiento actual</p>
      <h2>{record.title}</h2>
      <p class="current-record__status">{record.status}</p>
    </div>
    <SourceStatusBadge status="current-snapshot-differs" />
  </header>

  <p class="current-record__summary">{record.summary}</p>

  <dl class="current-record__facts">
    {
      record.facts.map((fact) => (
        <div>
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))
    }
  </dl>

  <div class="current-record__reading">
    <section aria-labelledby={`${record.id}-reading`}>
      <h3 id={`${record.id}-reading`}>Lectura de flujo de capital</h3>
      <p>{record.professionalReading}</p>
    </section>
    <section aria-labelledby={`${record.id}-methodology`}>
      <h3 id={`${record.id}-methodology`}>Cómo interpretar los porcentajes</h3>
      <p>{record.methodology}</p>
    </section>
  </div>

  <EvidenceSources sources={record.sources} />
</article>

<style>
  .current-record {
    padding: clamp(1.4rem, 4vw, 2.4rem);
    scroll-margin-top: 6rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--surface-color);
    box-shadow: var(--shadow-card);
  }

  .current-record__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .current-record__header .eyebrow {
    margin-bottom: 0.5rem;
  }

  .current-record h2 {
    margin-bottom: 0.55rem;
    font-size: clamp(1.65rem, 4vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .current-record__status {
    margin: 0;
    color: var(--accent-color);
    font-family: var(--heading-font);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .current-record__summary {
    max-width: 55rem;
    margin-bottom: 1.5rem;
    color: var(--subtitle-color);
    font-family: var(--heading-font);
    font-size: clamp(1rem, 2vw, 1.12rem);
    line-height: 1.7;
  }

  .current-record__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    margin-bottom: 1.5rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--border-color);
  }

  .current-record__facts div {
    padding: 1rem;
    background: var(--soft-background-color);
  }

  .current-record__facts dt {
    margin-bottom: 0.3rem;
    color: var(--default-color);
    font-family: var(--nav-font);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .current-record__facts dd {
    margin: 0;
    color: var(--heading-color);
    font-family: var(--heading-font);
    font-size: 0.92rem;
    font-weight: 600;
  }

  .current-record__reading {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .current-record__reading section {
    padding: 1.15rem 1.25rem;
    border-left: 0.2rem solid var(--accent-color);
    background: var(--light-background-color);
  }

  .current-record__reading section:last-child {
    border-left-color: #d5a237;
    background: #fff9ed;
  }

  .current-record__reading h3 {
    margin-bottom: 0.45rem;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .current-record__reading p {
    margin: 0;
    font-size: 0.88rem;
  }

  @media (max-width: 47.998rem) {
    .current-record__header {
      flex-direction: column;
    }

    .current-record__facts,
    .current-record__reading {
      grid-template-columns: 1fr;
    }
  }
</style>
