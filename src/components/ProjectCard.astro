---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const statusLabels = {
  featured: "Destacado",
  draft: "Borrador",
  archived: "Archivado",
} as const;
---

<article class={`project-card project-card--${project.status}`}>
  <div class="project-card__visual" aria-hidden="true">
    <span>{project.monogram}</span>
  </div>
  <div class="project-card__content">
    <div class="project-card__meta">
      <span>{project.category}</span>
      <span class="project-card__status">{statusLabels[project.status]}</span>
    </div>
    <h3>{project.title}</h3>
    <p>{project.summary}</p>
  </div>
</article>

<style>
  .project-card {
    display: grid;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--surface-color);
    box-shadow: var(--shadow-card);
  }

  .project-card__visual {
    position: relative;
    display: grid;
    min-height: 10rem;
    place-items: center;
    overflow: hidden;
    background:
      linear-gradient(135deg, rgb(52 152 219 / 15%), rgb(255 255 255 / 90%)),
      var(--soft-background-color);
  }

  .project-card__visual::before,
  .project-card__visual::after {
    position: absolute;
    border: 1px solid rgb(52 152 219 / 42%);
    border-radius: 50%;
    content: "";
  }

  .project-card__visual::before {
    width: 11rem;
    height: 11rem;
    transform: translate(22%, -15%);
  }

  .project-card__visual::after {
    width: 7rem;
    height: 7rem;
    transform: translate(-48%, 38%);
  }

  .project-card__visual span {
    position: relative;
    z-index: 1;
    display: grid;
    width: 4rem;
    height: 4rem;
    place-items: center;
    border: 2px solid var(--accent-color);
    border-radius: 50%;
    background: #ffffff;
    color: var(--accent-color);
    font-family: var(--heading-font);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .project-card__content {
    padding: 1.5rem;
  }

  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
    color: var(--accent-color);
    font-family: var(--nav-font);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .project-card__status {
    padding-inline: 0.5rem;
    border-left: 1px solid var(--accent-color);
  }

  .project-card h3 {
    margin-bottom: 0.75rem;
    font-size: 1.3rem;
    font-weight: 700;
  }

  .project-card p {
    margin-bottom: 0;
    color: var(--default-color);
    font-size: 0.94rem;
  }

  .project-card--draft {
    border-style: dashed;
  }
</style>
