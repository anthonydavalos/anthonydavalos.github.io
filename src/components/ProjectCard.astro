---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const statusLabels = {
  featured: "Destacado",
  draft: "Borrador",
  archived: "Archivado",
} as const;
---

<article class={`project-card project-card--${project.status}`}>
  <div class="project-card__visual">
    <img src={project.imageSrc} alt={project.imageAlt} loading="lazy" />
  </div>
  <div class="project-card__content">
    <div class="project-card__meta">
      <span>{project.category}</span>
      <span class="project-card__status">{statusLabels[project.status]}</span>
    </div>
    <h3>
      {
        project.repositoryUrl ? (
          <a href={project.repositoryUrl} target="_blank" rel="noreferrer">
            {project.title}
          </a>
        ) : (
          project.title
        )
      }
    </h3>
    <p>{project.summary}</p>
    {
      project.repositoryUrl && (
        <a
          class="project-card__repository"
          href={project.repositoryUrl}
          target="_blank"
          rel="noreferrer"
        >
          Ver repositorio <i class="bi bi-github" aria-hidden="true" />
        </a>
      )
    }
  </div>
</article>

<style>
  .project-card {
    display: grid;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--surface-color);
    box-shadow: var(--shadow-card);
  }

  .project-card__visual {
    min-height: 10rem;
    overflow: hidden;
    background: var(--soft-background-color);
  }

  .project-card__visual img {
    width: 100%;
    height: 100%;
    min-height: 10rem;
    object-fit: cover;
    object-position: center;
  }

  .project-card__content {
    padding: 1.5rem;
  }

  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
    color: var(--accent-color);
    font-family: var(--nav-font);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .project-card__status {
    padding-inline: 0.5rem;
    border-left: 1px solid var(--accent-color);
  }

  .project-card h3 {
    margin-bottom: 0.75rem;
    font-size: 1.3rem;
    font-weight: 700;
  }

  .project-card h3 a {
    color: inherit;
    text-decoration: none;
  }

  .project-card h3 a:hover {
    color: var(--accent-color);
  }

  .project-card p {
    margin-bottom: 0;
    color: var(--default-color);
    font-size: 0.94rem;
  }

  .project-card__repository {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.1rem;
    color: var(--accent-color);
    font-family: var(--nav-font);
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
  }

  .project-card--draft {
    border-style: dashed;
  }
</style>
