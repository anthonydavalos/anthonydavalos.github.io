---
import type { EvidenceStatus } from "../data/achievements";

interface Props {
  status: EvidenceStatus;
}

const { status } = Astro.props;
const labels: Record<EvidenceStatus, string> = {
  "verified-third-party": "Verificación externa",
  "public-owner-record": "Registro público",
  "archived-document": "Documento archivado",
  "source-unavailable": "Fuente no disponible",
  "current-snapshot-differs": "Instantánea diferente",
};
---

<span class={`source-status source-status--${status}`}>{labels[status]}</span>

<style>
  .source-status {
    display: inline-flex;
    align-items: center;
    padding: 0.32rem 0.62rem;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background: var(--soft-background-color);
    color: var(--default-color);
    font-family: var(--nav-font);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.035em;
    line-height: 1.3;
  }

  .source-status--verified-third-party,
  .source-status--public-owner-record {
    border-color: color-mix(in srgb, var(--accent-color), transparent 55%);
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .source-status--source-unavailable,
  .source-status--current-snapshot-differs {
    border-color: #e4c994;
    background: #fff9ed;
    color: #73540f;
  }
</style>
