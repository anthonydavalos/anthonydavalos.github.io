---
import type { AchievementSource } from "../data/achievements";

import SourceStatusBadge from "./SourceStatusBadge.astro";

interface Props {
  sources: AchievementSource[];
}

const { sources } = Astro.props;
---

<section class="evidence" aria-label="Fuentes y estado de la evidencia">
  <h3>Fuentes y trazabilidad</h3>
  <div class="evidence__list">
    {
      sources.map((source) => (
        <details class="evidence__source">
          <summary>
            <span>{source.label}</span>
            <SourceStatusBadge status={source.status} />
          </summary>
          <div class="evidence__content">
            <p>
              <strong>Disponibilidad:</strong> {source.availability}
            </p>
            <p>
              <strong>Campos respaldados:</strong> {source.supports.join(", ")}.
            </p>
            <p>
              <strong>Consultada:</strong> {source.checkedAt}.
            </p>
            {source.url && (
              <a href={source.url} rel="noopener noreferrer" target="_blank">
                Consultar fuente
                <span class="visually-hidden">
                  {" "}
                  (abre en una pestaña nueva)
                </span>
              </a>
            )}
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .evidence {
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
  }

  .evidence h3 {
    margin-bottom: 1rem;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .evidence__list {
    display: grid;
    gap: 0.65rem;
  }

  .evidence__source {
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: var(--surface-color);
  }

  .evidence__source summary {
    display: flex;
    min-height: 3.2rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.7rem 0.9rem;
    color: var(--heading-color);
    cursor: pointer;
    font-family: var(--heading-font);
    font-size: 0.86rem;
    font-weight: 600;
  }

  .evidence__source summary::marker {
    color: var(--accent-color);
  }

  .evidence__content {
    padding: 0 0.9rem 0.9rem;
  }

  .evidence__content p {
    margin-bottom: 0.45rem;
    font-size: 0.82rem;
  }

  .evidence__content a {
    display: inline-flex;
    margin-top: 0.35rem;
    color: var(--accent-color);
    font-family: var(--nav-font);
    font-size: 0.8rem;
    font-weight: 600;
  }

  @media (max-width: 35rem) {
    .evidence__source summary {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
