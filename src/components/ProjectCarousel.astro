---
import type { Project } from "../data/projects";

import ProjectCard from "./ProjectCard.astro";

interface Props {
  projects: Project[];
  title?: string;
}

const { projects, title = "Proyectos destacados" } = Astro.props;
---

<section class="project-carousel" aria-labelledby="featured-projects-title">
  <div class="container">
    <div class="section-heading" data-aos="fade-up">
      <p class="eyebrow section-heading__rule">Proyectos</p>
      <h2 id="featured-projects-title">{title}</h2>
      <p>Una selección inicial de trabajo en software y automatización.</p>
    </div>

    <div
      class="swiper project-carousel__viewport"
      data-swiper
      aria-label="Carrusel de proyectos destacados"
      data-aos="fade-up"
    >
      <div class="swiper-wrapper">
        {
          projects.map((project) => (
            <div class="swiper-slide">
              <ProjectCard project={project} />
            </div>
          ))
        }
      </div>
    </div>

    <div class="project-carousel__pagination" data-swiper-pagination></div>
    <p class="project-carousel__link">
      <a href="/proyectos/">Ver todos los proyectos</a>
    </p>
  </div>
</section>

<style>
  .project-carousel {
    padding-block: var(--section-space);
    background: var(--background-color);
  }

  .project-carousel__viewport .swiper-wrapper {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1.5rem;
  }

  .project-carousel__viewport[data-enhanced="true"] .swiper-wrapper {
    display: flex;
    gap: 0;
  }

  .project-carousel__viewport[data-enhanced="true"] .swiper-slide {
    height: auto;
  }

  .project-carousel__pagination {
    display: flex;
    justify-content: center;
    min-height: 1.5rem;
    margin-top: 1.5rem;
  }

  .project-carousel__link {
    margin: 1.25rem 0 0;
    text-align: center;
  }

  .project-carousel__link a {
    color: var(--accent-color);
    font-family: var(--nav-font);
    font-size: 0.85rem;
    font-weight: 600;
  }

  :global(.no-js) .project-carousel__pagination {
    display: none;
  }
</style>
